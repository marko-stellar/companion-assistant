# ============================================================
# COMPANION — Environment Variables
# Copy to .env (never commit .env) and fill in real values.
# All keys must be set server-side only; never expose to the browser.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Provided automatically by Replit's managed PostgreSQL.
# For local development, use a local or remote PostgreSQL 15+ instance
# with the pgvector extension enabled.
DATABASE_URL=postgresql://user:password@localhost:5432/companion

# ── Server ───────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# ── Session ──────────────────────────────────────────────────
# Minimum 32-char random string. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# ── Provider modes ───────────────────────────────────────────
# Every mode accepts "mock" (safe default) or "real".
# Invalid or empty mode values resolve to mock. Real never falls back.
SPEECH_MODE=mock
LLM_MODE=mock
SEARCH_MODE=mock
SMS_MODE=mock
EMBEDDING_MODE=mock
VISION_MODE=mock
WAKE_WORD_MODE=mock

# ── Speech Provider ──────────────────────────────────────────
# Required only for SPEECH_MODE=real.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# Optional voice ID overrides (built-in defaults are used when blank).
ELEVENLABS_VOICE_ANA=
ELEVENLABS_VOICE_MIA=
ELEVENLABS_VOICE_LUKA=
ELEVENLABS_VOICE_IVAN=

# ── LLM Provider ─────────────────────────────────────────────
# No real adapter is wired in this MVP. LLM_MODE=real fails explicitly.
LLM_PROVIDER=
# Reserved for a future server-side adapter:
ANTHROPIC_API_KEY=

# ── Search Provider ──────────────────────────────────────────
# No real adapter is wired in this MVP. SEARCH_MODE=real fails explicitly.
SEARCH_PROVIDER=
SEARCH_API_KEY=
SEARCH_API_BASE_URL=

# ── Notification Provider (SMS) ──────────────────────────────
# Required only for SMS_MODE=real. Routine deviation alone must never send SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Memory Embeddings ────────────────────────────────────────
# Mock mode uses keyword fallback and never calls OpenAI.
# Required only for EMBEDDING_MODE=real.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Photo Vision ─────────────────────────────────────────────
# No real adapter is wired in this MVP. Mock mode does not inspect photo bytes.
VISION_PROVIDER=

# ── Wake-word Detection ──────────────────────────────────────
# No real adapter is wired in this MVP. Mock mode is a no-op.
WAKE_WORD_PROVIDER=

# ── Storage Provider ─────────────────────────────────────────
# Replit Object Storage (preferred for deployed MVP).
# No keys needed in Replit — injected automatically.
# For local development, configure an S3-compatible store:
# OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# OBJECT_STORAGE_ACCESS_KEY=minioadmin
# OBJECT_STORAGE_SECRET_KEY=minioadmin
# OBJECT_STORAGE_BUCKET=companion
