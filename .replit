modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck-admin"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck-tablet"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck-api-server"

[[workflows.workflow]]
name = "typecheck-admin"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/admin run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck-tablet"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/tablet run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck-api-server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run typecheck"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["imagemagick"]

[userenv]

[userenv.shared]
SMS_MODE = "mock"
ELEVENLABS_STT_MODEL = "scribe_v1"
ELEVENLABS_TTS_MODEL = "eleven_multilingual_v2"
EMBEDDING_MODE = "mock"
LLM_MODE = "mock"
LLM_PROVIDER = ""
OPENAI_EMBEDDING_MODEL = "text-embedding-3-small"
SEARCH_API_BASE_URL = ""
SEARCH_MODE = "mock"
SEARCH_PROVIDER = ""
SPEECH_MODE = "mock"
VISION_MODE = "mock"
VISION_PROVIDER = ""
WAKE_WORD_MODE = "mock"
WAKE_WORD_PROVIDER = ""
